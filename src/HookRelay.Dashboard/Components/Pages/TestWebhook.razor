@page "/"
@inject HttpClient Http
@rendermode InteractiveServer

<PageTitle>Test Webhook</PageTitle>

<h2>Test Webhook</h2>

<div>
    <label>API Key:</label>
    <input @bind="apiKey" />
</div>

<div style="margin-top: 10px;">
    <label>Payload (JSON):</label>
    <textarea @bind="payload" rows="5" cols="50"></textarea>
</div>

<button style="margin-top: 10px;" @onclick="SendWebhook">Send Test Webhook</button>

@if (result is not null)
{
    <pre style="margin-top: 10px;">@result</pre>
}

@code {
    private string apiKey = "test123";
    private string payload = """{"event": "test", "amount": 42}""";
    private string? result;

    private async Task SendWebhook()
    {
        result = "Sending...";
        try
        {
            var content = new StringContent(payload, System.Text.Encoding.UTF8, "application/json");
            var response = await Http.PostAsync($"/hook/{apiKey}", content);
            result = $"Status: {(int)response.StatusCode} {response.ReasonPhrase}";
        }
        catch (Exception ex)
        {
            result = $"Error: {ex.Message}";
        }
    }
}

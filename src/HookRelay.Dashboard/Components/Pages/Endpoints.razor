@page "/"
@page "/endpoints"
@inject IEndpointRepository endpointRepository
@rendermode InteractiveServer

<PageTitle>Endpoints</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Endpoints</h2>
    <button class="btn btn-primary btn-sm" @onclick="() => showForm = !showForm">
        @(showForm ? "Cancel" : "New Endpoint")
    </button>
</div>

@if (showForm)
{
    <div class="card card-body mb-3">
        <div class="row g-2">
            <div class="col-md-4">
                <input class="form-control" placeholder="Name" @bind="newName" />
            </div>
            <div class="col-md-4">
                <input class="form-control" placeholder="Target URL" @bind="newUrl" />
            </div>
            <div class="col-md-3">
                <input class="form-control" placeholder="API Key" @bind="newApiKey" />
            </div>
            <div class="col-md-1">
                <button class="btn btn-success w-100" @onclick="AddEndpoint">Add</button>
            </div>
        </div>
    </div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>URL</th>
            <th>API Key</th>
            <th>Status</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var endpoint in endpoints)
        {
            <tr>
                <td>@endpoint.Name</td>
                <td><code>@endpoint.Url</code></td>
                <td><code>@endpoint.ApiKey</code></td>
                <td>
                    @if (endpoint.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>@endpoint.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <a href="/endpoints/@endpoint.Id/events" class="btn btn-sm btn-outline-primary">View Events</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Endpoint> endpoints = new();

    protected override async Task OnInitializedAsync()
    {
        endpoints = (await endpointRepository.GetAllAsync()).ToList();
    }

    private bool showForm;
    private string newName = "";
    private string newUrl = "";
    private string newApiKey = "";

    private async Task AddEndpoint()
    {
        if (string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(newUrl) || string.IsNullOrWhiteSpace(newApiKey))
            return;

        var newEndpoint = new Endpoint
        {
            Id = Guid.NewGuid(),
            Name = newName,
            Url = newUrl,
            ApiKey = newApiKey,
            IsActive = true,
            CreatedAt = DateTime.UtcNow
        };

        var created = await endpointRepository.CreateAsync(newEndpoint);
        if (created != null) endpoints.Add(created);

        newName = "";
        newUrl = "";
        newApiKey = "";
        showForm = false;
    }
}
